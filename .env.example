# Copy this file to .env and fill it in. .env holds secrets: do not share or commit it.
# Real environment variables override .env; command-line flags override both.

# Root folder for the final run: the year folder, laid out as
#   2024 > Dir1, Dir2, ... > "IT Software" / "Core" > 1.1, 1.2, ... > resumes
# It is walked depth-first (down to the resumes, then back up to the next directory).
REAL_PATH=D:/path/to/2024

# Cells with MORE words than this are compacted to FEWER than this.
NO_OF_WORDS=100

# Compaction fallback chain, tried left to right: provider:model,provider:model,...
# On a rate limit or other error the next entry is used; if all fail, the cell is trimmed
# without a model (so the run never stops). Providers: gemini, openai, local (Ollama).
# Leave empty (or "extractive") to use no model at all.
# Cloud entries send the text of long resume fields to that service.
COMPACT=gemini:gemini-2.5-flash,openai:gpt-4o-mini,local:qwen2.5:3b

# Keys for the cloud providers in COMPACT (entries with no key are skipped).
GEMINI_API_KEY=
OPENAI_API_KEY=

# Where Ollama is listening (only used by local: entries).
OLLAMA_URL=http://localhost:11434
